---
import { ClientRouter } from "astro:transitions";
import "../styles/globals.css";
import "aos/dist/aos.css";
import Footer from "../components/footer.astro";
import Navbar from "../components/navbar.astro";
import Net from "../components/net.astro";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Rounak Sen's Developer Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark" class="scroll-smooth">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link rel="icon" type="image/x-icon" href="/favicon.ico">
		<meta name="generator" content={Astro.generator}>
		<title>{title}</title>
		<meta name="description" content={description}>

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website">
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image">
		<meta property="twitter:title" content={title}>
		<meta property="twitter:description" content={description}>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link
			href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Fira+Code:wght@300..700&family=Grandstander:ital,wght@0,100..900;1,100..900&display=swap"
			rel="stylesheet"
			media="print"
			onload="this.media='all'"
		>
		<noscript>
			<link
				href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Fira+Code:wght@300..700&family=Grandstander:ital,wght@0,100..900;1,100..900&display=swap"
				rel="stylesheet"
			>
		</noscript>

		<ClientRouter />
		<script is:inline>
		// Immediate theme application to prevent flash
		const applyTheme = () => {
			const theme = localStorage.getItem("theme") || "dark";
			document.documentElement.setAttribute("data-theme", theme);
		};
		applyTheme();
		document.addEventListener("astro:after-swap", applyTheme);
		</script>
	</head>
	<body
		class="bg-transparent overflow-x-hidden selection:bg-primary/30 selection:text-primary"
	>
		<Net />
		<Navbar />
		<main id="main-content"><slot /></main>
		<Footer />

		<script>
		import AOS from "aos";
		import { themeChange } from "theme-change";
		import "@dotlottie/player-component";
		import { HSStaticMethods } from "preline";

		const initShared = () => {
			AOS.init({
				duration: 800,
				once: true,
				offset: 50,
			});

			setTimeout(() => {
				AOS.refresh();
			}, 200);

			themeChange(false);
			HSStaticMethods.autoInit();

			document.querySelectorAll("dotlottie-player").forEach((el) => {
				const player = el as HTMLElement & { play: () => void };
				setTimeout(() => {
					if (typeof player.play === "function") player.play();
				}, 50);
			});
		};

		document.addEventListener("astro:page-load", initShared);
		</script>
	</body>
</html>

<style is:global>
html {
	font-family: "Grandstander", "Fira Code", sans-serif;
	width: 100%;
	cursor:
		url("data:image/x-icon;base64,"),
		auto;
}

a,
img:hover {
	cursor:
		url("data:image/x-icon;base64,"),
		auto;
}

dotlottie-player {
	display: block;
}

code {
	font-family:
		Menlo,
		Monaco,
		Lucida Console,
		Liberation Mono,
		DejaVu Sans Mono,
		Bitstream Vera Sans Mono,
		Courier New,
		monospace;
}

.custom-scrollbar::-webkit-scrollbar-thumb {
	background: var(--color-primary);
}
</style>
