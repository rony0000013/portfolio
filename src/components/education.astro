---
import * as data from "../content/data/data.mdx";

import EducationEventHorizon from "./EducationEventHorizon";

import Pretext from "./Pretext.astro";

interface EducationItem {
	degree: string;
	institution: string;
	year: string;
	description: string;
}

const { education } = data.frontmatter as { education: EducationItem[] };
---

<div class="relative py-20 px-4 overflow-hidden" id="education">
	<!-- Gravity Well Line -->
	<div
		class="absolute left-1/2 top-0 bottom-0 w-px bg-linear-to-b from-transparent via-primary/30 to-transparent -translate-x-1/2 hidden md:block"
	></div>

	<div data-aos="fade-up" class="mb-24 text-center tracking-[0.2em]">
		<Pretext text="📚 EDUCATIONAL JOURNEY" size={48} />
	</div>

	<div class="max-w-6xl mx-auto space-y-12">
		{education.map((item: EducationItem, index: number) => (
				<EducationEventHorizon
					client:visible
					flip={index % 2 !== 0}
					{...item}
				/>
			))}
	</div>
</div>
