---
import handwaveLottie from "../assets/handwave.lottie";
import Title from "./title.astro";

const waveSrc =
	typeof handwaveLottie === "string" ? handwaveLottie : handwaveLottie.src;
---

<div class="h-screen hero backdrop-blur-none" id="hero">
	<div class="text-center hero-content text-neutral-content -mt-24 md:mt-0">
		<div>
			<h1
				class="text-5xl font-bold text-white flex items-center justify-center gap-1"
				style="color: white !important;"
			>
				Hi
				<div
					class="relative size-16 flex items-center justify-center -mt-2 -mx-1"
				>
					<dotlottie-player
						autoplay
						loop
						src={waveSrc}
						class="size-20 brightness-[0.4] contrast-[1.1] sepia-[0.2]"
					></dotlottie-player>
				</div>
				I am,
			</h1>
			<Title />
		</div>
	</div>
</div>
