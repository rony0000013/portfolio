---
interface Props {
	text: string;
	size?: number;
}
const { text, size = 16 } = Astro.props;
---

<div class="pretext-container my-12" data-text={text} data-size={size}>
	<div class="flex flex-col items-center w-full overflow-hidden">
		<canvas class="pretext-canvas max-w-[95vw] h-auto"></canvas>
	</div>
	<div class="sr-only text-base-content">{text}</div>
</div>

<script>
class FastPretext {
	el!: HTMLElement;
	canvas!: HTMLCanvasElement;
	ctx!: CanvasRenderingContext2D;
	text!: string;
	baseFontSize!: number;
	chars!: string[];
	time!: number;
	active!: boolean;
	autoX!: number;
	autoY!: number;
	currentLine!: number;
	mouseX!: number;
	mouseY!: number;
	words!: string[];
	lineHeight!: number;
	totalH!: number;
	maskData!: Uint8ClampedArray;
	maskW!: number;
	maskH!: number;
	resX!: number;
	resY!: number;
	charFontSize!: number;

	constructor(el: HTMLElement) {
		this.el = el;
		this.canvas = el.querySelector(".pretext-canvas") as HTMLCanvasElement;
		if (!this.canvas) return;

		const context = this.canvas.getContext("2d", { alpha: true });
		if (!context) return;
		this.ctx = context;

		this.text = (el.dataset.text || "").toUpperCase();
		this.baseFontSize = parseInt(el.dataset.size || "16", 10);
		this.chars = ["#", "o", ".", " "].reverse();
		this.time = 0;
		this.active = false;

		// Auto Animation State
		this.autoX = -200;
		this.autoY = 0;
		this.currentLine = 0;

		this.mouseX = -1000;
		this.mouseY = -1000;

		this.init();
	}

	async init() {
		if (!this.canvas) return;
		await document.fonts.ready;
		this.render();

		const updateMouse = (x: number, y: number) => {
			const rect = this.canvas.getBoundingClientRect();
			if (!rect) return;
			const scaleX = this.canvas.width / rect.width;
			const scaleY = this.canvas.height / rect.height;
			this.mouseX = (x - rect.left) * scaleX;
			this.mouseY = (y - rect.top) * scaleY;
		};

		window.addEventListener("mousemove", (e) =>
			updateMouse(e.clientX, e.clientY),
		);
		window.addEventListener(
			"touchstart",
			(e) => {
				if (e.touches[0])
					updateMouse(e.touches[0].clientX, e.touches[0].clientY);
			},
			{ passive: true },
		);
		window.addEventListener(
			"touchmove",
			(e) => {
				if (e.touches[0])
					updateMouse(e.touches[0].clientX, e.touches[0].clientY);
			},
			{ passive: true },
		);

		this.animate();
		const observer = new IntersectionObserver((entries) => {
			this.active = entries[0].isIntersecting;
		});
		observer.observe(this.el);
		window.addEventListener("resize", () => this.render());
	}

	render() {
		if (!this.canvas) return;
		const isMobile = window.innerWidth < 768;
		const virtualWidth = isMobile ? 1200 : 1800;
		const refChars = isMobile ? 12 : 24;
		const maskFontSize =
			Math.floor(virtualWidth / refChars) * (isMobile ? 1.8 : 1.3);

		const stylishFont = "Grandstander, Georgia, serif";
		const font = `900 ${maskFontSize}px ${stylishFont}`;

		const tempCanvas = document.createElement("canvas");
		const tCtx = tempCanvas.getContext("2d");
		if (!tCtx) return;

		tCtx.font = font;
		tCtx.letterSpacing = isMobile ? "2px" : "12px";

		this.words = isMobile ? this.text.split(" ") : [this.text];
		this.lineHeight = maskFontSize * 1.2;
		const w = virtualWidth;
		this.totalH = Math.ceil(this.lineHeight * this.words.length * 1.4);

		tempCanvas.width = w;
		tempCanvas.height = this.totalH;

		tCtx.fillStyle = "black";
		tCtx.fillRect(0, 0, w, this.totalH);
		tCtx.fillStyle = "white";
		tCtx.font = font;
		tCtx.letterSpacing = isMobile ? "2px" : "12px";
		tCtx.textAlign = "center";
		tCtx.textBaseline = "middle";

		this.words.forEach((word, i) => {
			const yPos =
				this.totalH / 2 -
				((this.words.length - 1) * this.lineHeight) / 2 +
				i * this.lineHeight;
			tCtx.fillText(word, w / 2, yPos);
		});

		this.maskData = tCtx.getImageData(0, 0, w, this.totalH).data;
		this.maskW = w;
		this.maskH = this.totalH;
		this.canvas.width = w;
		this.canvas.height = this.totalH;

		this.resX = isMobile ? 8 : 4;
		this.resY = isMobile ? 14 : 7;
		this.charFontSize = Math.floor(maskFontSize * 0.1);
	}

	animate() {
		if (this.active) {
			this.time++;

			// SLOWER speed for premium feel
			const speed = 6;
			this.autoX += speed;

			// Calculate target Y based on the current line being scanned
			const targetY =
				this.totalH / 2 -
				((this.words.length - 1) * this.lineHeight) / 2 +
				this.currentLine * this.lineHeight;

			// Smoothly lerp towards the target line Y
			this.autoY += (targetY - this.autoY) * 0.1;
			// Add a bit of HUD-like oscillation
			const dynamicY = this.autoY + Math.sin(this.time * 0.05) * 15;

			// Reset and switch line logic
			if (this.autoX > this.maskW + 300) {
				this.autoX = -300;
				this.currentLine = (this.currentLine + 1) % this.words.length;
			}

			this.draw(dynamicY);
		}
		requestAnimationFrame(() => this.animate());
	}

	draw(dynamicY: number) {
		const { maskData, maskW, maskH, ctx, canvas, resX, resY } = this;
		if (!maskData || !ctx || !canvas) return;

		const isMobile = window.innerWidth < 768;
		ctx.clearRect(0, 0, canvas.width, canvas.height);
		ctx.textAlign = "center";
		ctx.textBaseline = "middle";
		ctx.font = `${this.charFontSize}px monospace`;

		const hoverRadius = isMobile ? 80 : 120;
		// BIGGER circle for automatic scan
		const autoRadius = isMobile ? 130 : 100;

		for (let y = 0; y < maskH; y += resY) {
			for (let x = 0; x < maskW; x += resX) {
				const idx = (Math.floor(y) * maskW + Math.floor(x)) * 4;
				const b = (maskData[idx] + maskData[idx + 1] + maskData[idx + 2]) / 765;

				if (b > 0.05) {
					const charIdx = Math.floor(b * (this.chars.length - 1));
					const char = this.chars[charIdx];

					const distMouse = Math.hypot(x - this.mouseX, y - this.mouseY);
					const distAuto = Math.hypot(x - this.autoX, y - dynamicY);

					const flowSpeed = 0.04;
					const flowX = Math.sin(this.time * flowSpeed + y * 0.01) * 6;
					const flowY = Math.cos(this.time * flowSpeed + x * 0.01) * 4;

					let color = "white";
					let opacity = 0.2 + b * 0.5;
					let drawX = x + flowX;
					let drawY = y + flowY;

					if (distMouse < hoverRadius) {
						const f = (hoverRadius - distMouse) / hoverRadius;
						drawX += (x - this.mouseX) * f * 0.4;
						drawY += (y - this.mouseY) * f * 0.4;
						const hue = Math.floor(x * 0.4 + y * 0.2 + this.time * 2) % 360;
						color = `hsl(${hue}, 100%, 75%)`;
						opacity = 1;
					} else if (distAuto < autoRadius) {
						const f = (autoRadius - distAuto) / autoRadius;
						opacity = 0.2 + b * 0.6 + f * 0.8;
						const hue = Math.floor(x * 0.4 + y * 0.1 + this.time * 2) % 360;
						color = `hsl(${hue}, 100%, 80%)`;
						// Balanced circular displacement
						drawX += Math.cos(this.time * 0.1) * 6 * f;
						drawY += Math.sin(this.time * 0.1) * 6 * f;
					}

					ctx.globalAlpha = Math.min(1, opacity);
					ctx.fillStyle = color;
					ctx.fillText(char, drawX, drawY);
				}
			}
		}
	}
}

const init = () => {
	document.querySelectorAll(".pretext-container").forEach((el) => {
		if (!el.hasAttribute("data-initialized")) {
			el.setAttribute("data-initialized", "true");
			new FastPretext(el as HTMLElement);
		}
	});
};
document.addEventListener("DOMContentLoaded", init);
document.addEventListener("astro:after-swap", init);
</script>
