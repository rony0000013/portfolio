---
import Pretext from "./Pretext.astro";
---

<div id="spotify" class="mt-24 relative z-10">
	<div class="mb-10">
		<Pretext data-aos="fade-up" text="🎵 My Playlists" size={24} />
	</div>
	<div class="flex flex-wrap items-center justify-center gap-10 my-10">
		<iframe
			style="border-radius:2rem"
			src="https://open.spotify.com/embed/playlist/5xZLxx0KXXatKgscsg3aNw?utm_source=generator&theme=0"
			title="Awesome-playlist"
			height="500"
			allow="
				autoplay;
				clipboard-write;
				encrypted-media;
				fullscreen;
				picture-in-picture;
			"
			loading="lazy"
			class="md:w-[500px] w-[300px] border-none"
		></iframe>
		<iframe
			style="border-radius:2rem"
			src="https://open.spotify.com/embed/playlist/3uv21IwhuqkcQiyIcRjn8u?utm_source=generator&theme=0"
			title="Cool&Chill-playlist"
			height="500"
			allow="
				autoplay;
				clipboard-write;
				encrypted-media;
				fullscreen;
				picture-in-picture;
			"
			loading="lazy"
			class="md:w-[500px] w-[300px] border-none"
		></iframe>
	</div>
</div>
