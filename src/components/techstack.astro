---
import HoneycombGrid from "./HoneycombGrid";

import Pretext from "./Pretext.astro";
---

<div id="skills" class="flex flex-col items-center my-20 px-4">
	<div data-aos="fade-up" class="my-20">
		<Pretext text="💻 SYSTEM CAPABILITIES" size={24} />
	</div>

	<div class="w-full space-y-20">
		<HoneycombGrid
			client:load
			title="🕉️ Languages & Logic"
			category="languages"
		/>
		<HoneycombGrid
			client:load
			title="🧠 Neural Networks & AI"
			category="aiml"
		/>
		<HoneycombGrid
			client:load
			title="💻 Neural Interface (Frontend)"
			category="frontends"
		/>
		<HoneycombGrid
			client:load
			title="💾 Core Systems (Backend)"
			category="backends"
		/>
		<HoneycombGrid client:load title="🔥 Universal Tools" category="tools" />
	</div>
</div>
